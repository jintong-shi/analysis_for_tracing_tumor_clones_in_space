# Harness / editor / OS tooling
.claude/
.codex/
.mcp.json
.vscode/
.ipynb_checkpoints/

# Python / R runtime
__pycache__/
*.pyc
.Rhistory
.RData
Rplots.pdf

# Snakemake / logs / scratch
.snakemake/
*.log
nohup.out
.DS_Store

# No bulk data in this repo — guard against accidental commits
*.rds
*.rds.gz
*.parquet
*.h5
*.h5ad
*.bam

# Exception: frozen figure inputs ARE shipped, so the figure scripts run as-is
!figures/*/input_data/**

# ...except the oversized high-res ST inputs — Zenodo only (see README)
figures/high_res_st/input_data/atera/atera_subclone_cnv_input.rds
figures/high_res_st/input_data/novaseq/novaseq_g3_merged_m3_cnv_input.rds
figures/high_res_st/input_data/strataMap/strataMap_supp_cells.csv
figures/high_res_st/input_data/visiumHD/deconv_vs_histology.csv
figures/high_res_st/input_data/visiumHD/infercnv/*.infercnv_obj

# Figure outputs are regenerated by the scripts
figures/*/main_figures/
figures/*/supp_figures/
figures/*/data_tables/
