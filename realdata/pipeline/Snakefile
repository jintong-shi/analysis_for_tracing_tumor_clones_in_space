def infercnv_hmm_flag(wc):
    """Read infercnv HMM switch from config and pass lowercase true/false to R script."""
    cfg = config.get("infercnv", {})
    # Support both HMM and hmm keys, default false when unset.
    val = cfg["HMM"] if "HMM" in cfg else cfg.get("hmm", False)
    if isinstance(val, bool):
        return "true" if val else "false"

    sval = str(val).strip().lower()
    if sval in ("true", "false"):
        return sval

    raise ValueError("config.infercnv.HMM must be true or false")

