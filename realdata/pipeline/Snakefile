# ---------- 最终目标 ----------
# ---- sample type ----
SAMPLE_TYPE = str(config.get("sample_type", "freshfrozen")).strip().lower()
IS_FFPE = (SAMPLE_TYPE == "ffpe")

# 默认工具集合（全小写）
FFPE_TOOLS  = {"copykat", "scevan", "infercnv", "tuscan", "copyvae", "conicsmat","starch","infercnvpy"}
FRESH_TOOLS = {"copykat", "scevan", "infercnv", "tuscan", "copyvae", "conicsmat", "starch","xclone","infercnvpy","calicost"}

# 用户指定（大小写不敏感）
USER_TOOLS = set(t.strip().lower() for t in config.get("tools", []))

# 目录名规范化（根据你现有的规则输出路径保持一致）
def tool_dir(tool: str) -> str:
    t = tool.lower()
    if t in {"copykat", "scevan", "tuscan", "starch"}: return t.upper()
    if t == "infercnv":  return "infercnv"
    if t == "copyvae":   return "copyVAE"
    if t == "conicsmat": return "CONICSmat"
    if t == "xclone":    return "XCLONE"
    if t == "infercnvpy": return "infercnvpy"
    if t == "calicost":    return "CalicoST"
    return tool

# 选用的工具集合
if USER_TOOLS:
    SELECTED_TOOLS = (USER_TOOLS & FFPE_TOOLS) if IS_FFPE else USER_TOOLS
else:
    SELECTED_TOOLS = FFPE_TOOLS if IS_FFPE else FRESH_TOOLS

def _add_tool_target(outs, combo, tool_key):
    outs.append(f"{combo_root(SAMPLE, combo)}/{tool_dir(tool_key)}/_DONE.txt")

def expected_benchmark_files_for_combo(combo_name):
    c_key = canon_combo(combo_name)
    files = []

    if c_key == "histo_pure_benign":
        hpb_tools = [
            str(t).strip().lower()
            for t in config.get("histo_pure_benign", {}).get("tools", ["copykat", "SCEVAN", "infercnv"])
        ]
        if "copykat" in hpb_tools:
            files += [
                bench_path(combo_name, "copykat", "stage1"),
                bench_path(combo_name, "copykat", "stage2"),
            ]
        if "scevan" in hpb_tools:
            files += [
                bench_path(combo_name, "scevan", "stage1"),
                bench_path(combo_name, "scevan", "stage2"),
            ]
        if "infercnv" in hpb_tools and INFERCNV_GENE_POS:
            files.append(bench_path(combo_name, "infercnv", "hpb_2step"))
        return files

    if c_key == "decon_auto_ref":
        files.append(bench_path(combo_name, "autoref", "build"))

    if "copykat" in SELECTED_TOOLS:
        files.append(bench_path(combo_name, "copykat", "main"))
    if "scevan" in SELECTED_TOOLS:
        files.append(bench_path(combo_name, "scevan", "main"))
    if "infercnv" in SELECTED_TOOLS and INFERCNV_GENE_POS:
        files.append(bench_path(combo_name, "infercnv", "main"))
    if "infercnvpy" in SELECTED_TOOLS:
        files += [
            bench_path(combo_name, "infercnvpy", "prepare"),
            bench_path(combo_name, "infercnvpy", "main"),
        ]
    if "conicsmat" in SELECTED_TOOLS and (c_key in COMBOS_WITH_REF):
        files.append(bench_path(combo_name, "conicsmat", "main"))
    if "xclone" in SELECTED_TOOLS and (c_key in COMBOS_WITH_REF):
        files += [
            bench_path(combo_name, "xclone", "prepare"),
            bench_path(combo_name, "xclone", "main"),
        ]
    if "numbat" in SELECTED_TOOLS and (c_key in COMBOS_WITH_REF):
        files += [
            bench_path(combo_name, "numbat", "pileup_phase"),
            bench_path(combo_name, "numbat", "main"),
        ]

    if is_no_ref(c_key):
        if "tuscan" in SELECTED_TOOLS:
            files.append(bench_path(combo_name, "tuscan", "main"))
        if "copyvae" in SELECTED_TOOLS:
            files += [
                bench_path(combo_name, "copyvae", "prepare"),
                bench_path(combo_name, "copyvae", "main"),
            ]
        if "starch" in SELECTED_TOOLS:
            files.append(bench_path(combo_name, "starch", "main"))
        if "calicost" in SELECTED_TOOLS:
            files += [
                bench_path(combo_name, "calicost", "prepare_cfg"),
                bench_path(combo_name, "calicost", "snp"),
                bench_path(combo_name, "calicost", "cna"),
            ]

    return files

def final_targets():
    outs = []
    outs.append(CONFIG_OK)
    for c_raw in config["run_combos"]:
        c = canon_combo(c_raw)

        if c == "histo_pure_benign":
            for t in config.get("histo_pure_benign", {}).get("tools", ["copykat", "SCEVAN", "infercnv"]):
                outs.append(f"{combo_root(SAMPLE, 'histo_pure_benign')}/stage2_epi_withref/{t}/_DONE.txt")
            outs.append(cost_summary_path(c))
            continue
        if c == "decon_auto_ref":
            outs += [
                autoref_keep_path(SAMPLE),
                autoref_ref_path(SAMPLE),
                f"{combo_root(SAMPLE,'decon_auto_ref')}/_READY.txt"
            ]

        if "copykat" in SELECTED_TOOLS:_add_tool_target(outs, c, "copykat")
        if "scevan" in SELECTED_TOOLS:_add_tool_target(outs, c, "scevan")
        if "infercnv" in SELECTED_TOOLS and INFERCNV_GENE_POS:_add_tool_target(outs, c, "infercnv")
        if "infercnvpy" in SELECTED_TOOLS: _add_tool_target(outs, c, "infercnvpy")
        if "xclone" in SELECTED_TOOLS and combo_needs_ref(c):_add_tool_target(outs, c, "xclone")
        if "numbat" in SELECTED_TOOLS and combo_needs_ref(c):_add_tool_target(outs, c, "NUMBAT")
        if "conicsmat" in SELECTED_TOOLS and combo_needs_ref(c):_add_tool_target(outs, c, "conicsmat")
        if is_no_ref(c):
            for tk in ("tuscan", "copyvae", "starch","calicost"):
                if tk in SELECTED_TOOLS:
                    _add_tool_target(outs, c, tk)
        outs.append(cost_summary_path(c))
        if config.get("cell2location", {}).get("run", False):
                outs.append(f"{OUTROOT}/{SAMPLE}/cell2location/Decon_proportion.csv")
    
    return outs

rule all:
    input: final_targets()

# ------------ validate config early ------------
rule validate_config:
    output: CONFIG_OK
    run:
        import os, re, csv, gzip
        from pathlib import Path

        errors = []
        warnings = []

        # run_combos legality
        run_combos = [canon_combo(c) for c in config.get("run_combos", [])]
        if not run_combos:
            errors.append("run_combos is empty.")
        else:
            bad = set(run_combos) - COMBOS_ALLOWED
            if bad:
                errors.append(f"Unknown combo(s): {sorted(bad)}; allowed: {sorted(COMBOS_ALLOWED)}")

        # tools subset check
        user_tools = [t.strip().lower() for t in config.get("tools", [])]
        bad_tools = set(user_tools) - TOOLS_ALLOWED
        if bad_tools:
            errors.append(f"Unknown tool(s) in config.tools: {sorted(bad_tools)}; allowed: {sorted(TOOLS_ALLOWED)}")

        # Determine effective tools (mirror Snakefile logic)
        sample_type = str(config.get("sample_type","ffpe")).strip().lower()
        is_ffpe = (sample_type == "ffpe")
        ffpe_tools  = {"copykat", "scevan", "infercnv", "tuscan", "copyvae", "conicsmat", "starch", "infercnvpy"}
        fresh_tools = {"copykat", "scevan", "infercnv", "tuscan", "copyvae", "conicsmat", "starch", "xclone", "infercnvpy", "calicost"}
        if user_tools:
            selected = (set(user_tools) & ffpe_tools) if is_ffpe else set(user_tools)
        else:
            selected = ffpe_tools if is_ffpe else fresh_tools

        # required reference files by tool
        def req_file(path, label):
            if not path or not os.path.exists(path):
                errors.append(f"Missing required file for {label}: {path}")

        if "infercnv" in selected:
            infercnv = config.get("infercnv", {})
            req_file(infercnv.get("gene_pos_file",""), "infercnv.gene_pos_file")

        if "conicsmat" in selected:
            conics = config.get("conicsmat", {})
            req_file(conics.get("chrom_arm_file",""), "conicsmat.chrom_arm_file")

        if "copyvae" in selected:
            req_file(config.get("copyvae_gene_map_csv",""), "copyVAE gene_map_csv")
            copyvae = config.get("copyvae", {})
            req_file(copyvae.get("cell_cycle_file",""), "copyVAE.cell_cycle_file")
        
        # decon header checks if needed
        def sniff_header(path):
            opener = gzip.open if path.endswith(".gz") else open
            with opener(path, "rt", newline="") as fh:
                sample = fh.read(4096)
                dialect = csv.Sniffer().sniff(sample, delimiters=",;\t")
                fh.seek(0)
                reader = csv.reader(fh, dialect)
                header = next(reader)
                return [h.strip() for h in header]

        def parse_keys(x):
            return [s.strip().lower() for s in str(x or '').split(',') if s.strip()]

        needs_decon = any(c in {"decon_no_ref","decon_stromaimm_ref","decon_auto_ref"} for c in run_combos)
        if needs_decon:
            dc = config.get("decon", {})
            epi_keys    = parse_keys(dc.get("epi_celltypes",""))
            stroma_keys = parse_keys(dc.get("stroma_celltypes",""))
            imm_keys    = parse_keys(dc.get("imm_celltypes",""))

            if not epi_keys:
                errors.append("decon.epi_celltypes is required for decon_* combos.")
            if "decon_stromaimm_ref" in run_combos and not stroma_keys:
                errors.append("decon.stroma_celltypes is required for decon_stromaimm_ref.")
            if "decon_stromaimm_ref" in run_combos and not imm_keys:
                errors.append("decon.imm_celltypes is required for decon_stromaimm_ref.")

            # If cell2location is enabled, decon CSV is generated at runtime.
            if config.get("cell2location", {}).get("run", False):
                c2l = config.get("cell2location", {})
                req_file(c2l.get("sc_ref_folder",""), "cell2location.sc_ref_folder")
                if not str(c2l.get("cell_type_col","")).strip():
                    errors.append("cell2location.cell_type_col is required when cell2location.run=True.")
                if not str(c2l.get("batch_key","")).strip():
                    warnings.append("cell2location.batch_key is empty; this is unusual for reference training.")
                pybin = str(c2l.get("python_bin", C2L_PYBIN_DEFAULT)).strip()
                if pybin and not os.path.exists(pybin):
                    errors.append(f"cell2location.python_bin not found: {pybin}")
            else:
                decon_csv = config.get("decon_csv","")
                if not decon_csv or not os.path.exists(decon_csv):
                    errors.append(f"decon combo requested but decon_csv not found: {decon_csv}")
                else:
                    header = []
                    try:
                        header = sniff_header(decon_csv)
                    except Exception as e:
                        errors.append(f"Failed to read decon_csv header: {decon_csv} ({e})")
                    else:
                        header_l = [h.lower() for h in header]
                        def any_match(keys):
                            return any(any(k in col for col in header_l) for k in keys) if keys else False
                        if epi_keys and not any_match(epi_keys):
                            warnings.append("No matching columns for decon.epi_celltypes in decon_csv header.")
                        if stroma_keys and not any_match(stroma_keys):
                            warnings.append("No matching columns for decon.stroma_celltypes in decon_csv header.")
                        if imm_keys and not any_match(imm_keys):
                            warnings.append("No matching columns for decon.imm_celltypes in decon_csv header.")

        needs_histo = any(c in {"histo_pure_benign", "histo_tumor_benign_ref"} for c in run_combos)
        if needs_histo:
            histcsv = config.get("histology_csv","")
            if not histcsv:
                warnings.append("histology-based combo requested but histology_csv is empty; will rely on Seurat export step.")
            elif not os.path.exists(histcsv):
                errors.append(f"histology-based combo requested but histology_csv not found: {histcsv}")

        if errors:
            msg = "\n- ".join(errors)
            raise ValueError("Config validation failed:\n- " + msg)
        from pathlib import Path
        Path(str(output[0])).parent.mkdir(parents=True, exist_ok=True)
        Path(str(output[0])).write_text("OK\n" + "\n".join(warnings))

