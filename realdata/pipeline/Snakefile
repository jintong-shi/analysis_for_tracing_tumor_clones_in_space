    '''

rule numbat_pileup_phase:
    input:
        pkg_ok = ".snakemake/flags/numbat_pkg_installed.ok",
        bam    = BAM_FILE,
        keep   = lambda wc: keep_path(wc.combo)
    output:
        allele = f"{OUTROOT}/{SAMPLE}/{{combo}}/NUMBAT/{SAMPLE}_allele_counts.tsv.gz"
    threads: GLOBAL_THREADS
    conda: "envs/numbat.yml"
    params:
        outdir = f"{OUTROOT}/{SAMPLE}/{{combo}}/NUMBAT",
        gmap   = REFS.get("gmap_file", ""),
        eagle  = REFS.get("eagle_bin", ""),
        snpvcf = REFS.get("snp_vcf", ""),
        panel  = REFS.get("panel_dir", ""),
        label  = SAMPLE,
        samples= SAMPLE,
        UMI    = NUMBAT.get("UMI_tag", "UB"),
        CELL   = NUMBAT.get("cell_tag", "CB"),
    benchmark: bench_path("{combo}", "numbat", "pileup_phase")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}"

        export R_PROFILE_USER=/dev/null
        export R_ENVIRON_USER=/dev/null

        command -v cellsnp-lite >/dev/null 2>&1 || (echo "[ERROR] cellsnp-lite not in PATH" >&2; exit 127)
        command -v samtools     >/dev/null 2>&1 || (echo "[ERROR] samtools not in PATH" >&2; exit 127)
        command -v bcftools     >/dev/null 2>&1 || (echo "[ERROR] bcftools not in PATH" >&2; exit 127)

        BIN=$(Rscript --vanilla -e 'cat(system.file("bin","pileup_and_phase.R", package="numbat"))')
        [ -s "$BIN" ] || {{ echo "numbat::pileup_and_phase.R not found"; exit 1; }}

        Rscript --vanilla "$BIN" \
          --label "{params.label}" \
          --samples "{params.samples}" \
          --bams "{input.bam}" \
          --barcodes "{input.keep}" \
          --outdir "{params.outdir}" \
          --gmap "{params.gmap}" \
          --eagle "{params.eagle}" \
          --snpvcf "{params.snpvcf}" \
          --paneldir "{params.panel}" \
          --ncores {threads} \
          --UMItag "{params.UMI}" \
          --cellTAG "{params.CELL}"

        test -s "{output.allele}"
        """

rule numbat:
    input:
        setup  = ".snakemake/flags/numbat_pkg_installed.ok",
        keep   = lambda wc: keep_path(wc.combo),
        ref    = lambda wc: ref_path(wc.combo),  # Required for with-ref combos
        allele = f"{OUTROOT}/{SAMPLE}/{{combo}}/NUMBAT/{SAMPLE}_allele_counts.tsv.gz"
    output:
        done   = f"{OUTROOT}/{SAMPLE}/{{combo}}/NUMBAT/_DONE.txt"
    threads: GLOBAL_THREADS
    conda: "envs/numbat.yml"
    params:
        outdir = f"{OUTROOT}/{SAMPLE}/{{combo}}/NUMBAT",
        visium = config["input_path"],
        genome = config.get("refs", {}).get("genome_build", "hg38"),
        max_ent= NUMBAT.get("max_entropy", 0.8),
        min_LLR= NUMBAT.get("min_LLR", 0),
        tval   = NUMBAT.get("t", 1e-5),
        min_cells = NUMBAT.get("min_cells", 5),
        plot   = "true" if NUMBAT.get("plot", False) else "false"
    benchmark: bench_path("{combo}", "numbat", "main")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "{params.outdir}"

        # ref 必须存在且非空
        test -s "{input.ref}" || ( echo "[NUMBAT] empty ref file: {input.ref}" >&2; exit 2 )

        # 隔离 R
        export R_PROFILE_USER=/dev/null
        export R_ENVIRON_USER=/dev/null

        Rscript --vanilla R/run_numbat.R \
          --visium_folder="{params.visium}" \
          --barcodes_file="{input.keep}" \
          --ref_barcodes_file="{input.ref}" \
          --allele_tsv_gz="{input.allele}" \
          --outdir="{params.outdir}" \
          --genome="{params.genome}" \
          --ncores="{threads}" \
          --max_entropy="{params.max_ent}" \
          --min_LLR="{params.min_LLR}" \
          --t="{params.tval}" \
          --min_cells="{params.min_cells}" \
          --plot="{params.plot}"

        touch "{output.done}"
        """

