# label.csv → ref.txt
rule label2ref___hpb:
    input:
        s1done = lambda wc: f"{tool_stage1_dir(SAMPLE, wc.tool)}/_DONE.txt"
    output:
        ref = f"{hpb_root(SAMPLE)}/ref/{{tool}}_ref.txt"
    conda:  "envs/r-shared.yml"
    params:
        positive   = HPB_POSITIVE,
        label_path = lambda wc: tool_label_csv(SAMPLE, wc.tool)
    shell: r"""
        if [ ! -s "{params.label_path}" ]; then
          echo "[HPB] label CSV not found: {params.label_path}" >&2
          exit 1
        fi
        outdir="$(dirname "{output.ref}")"
        mkdir -p "$outdir"
        Rscript R/label_to_ref.R \
          --label_csv "{params.label_path}" \
          --out_ref   "{output.ref}" \
          --positive  "{params.positive}"
    """

# Stage-2（epi with-ref）
