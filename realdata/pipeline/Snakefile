# ------------ Xclone ------------
rule xclone_merge_barcodes:
    input:
        keep = lambda wc: keep_path(wc.combo),
        ref  = lambda wc: ref_path(wc.combo)
    output:
        union = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/barcodes_union.tsv"
    threads: 1
    shell: r"""
        # Concatenate both files, sort, and remove duplicates
        cat "{input.keep}" "{input.ref}" | sort | uniq > "{output.union}"
    """

rule xcltk_prepare:
    input:
        bam     = BAM_FILE, 
        barcode = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/barcodes_union.tsv"
    output:
        # BAF outputs
        baf_ad  = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/BAF/3_baf_fc/xcltk.AD.mtx",
        baf_dp  = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/BAF/3_baf_fc/xcltk.DP.mtx",
        # RDR outputs
        rdr_mtx = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/RDR/matrix.mtx",
        rdr_bar = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/RDR/barcodes.tsv"
    params:
        baf_out = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/BAF",
        rdr_out = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/RDR",
        # Config params
        snpvcf    = REFS.get("snp_vcf", ""),
        region    = XCLONE.get("gene_region", ""),
        gmap      = REFS.get("gmap_file", ""),
        eagle     = REFS.get("eagle_bin", ""),
        panel     = REFS.get("panel_dir", "")
    conda: "envs/xclone.yml" # Ensure you have this env or use your existing xcltk env name
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "xclone", "prepare")
    shell: r"""
        set -euo pipefail
        # Force the activated conda runtime libs ahead of system libstdc++ on cluster nodes.
        export LD_LIBRARY_PATH="$CONDA_PREFIX/lib${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}"

        # 1. Run BAF
        mkdir -p "{params.baf_out}"
        xcltk baf \
            --label "{SAMPLE}" \
            --sam "{input.bam}" \
            --barcode "{input.barcode}" \
            --snpvcf "{params.snpvcf}" \
            --region "{params.region}" \
            --outdir "{params.baf_out}" \
            --gmap "{params.gmap}" \
            --eagle "{params.eagle}" \
            --paneldir "{params.panel}" \
            --ncores {threads}

        # 2. Run RDR (basefc)
        mkdir -p "{params.rdr_out}"
        xcltk basefc \
            --sam "{input.bam}" \
            --barcode "{input.barcode}" \
            --region "{params.region}" \
            --outdir "{params.rdr_out}" \
            --ncores {threads}
    """

