        dataset     = SAMPLE,
        genome_mode = XCLONE.get("genome_mode", "hg38_genes")
    conda: "envs/xclone.yml"
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "xclone", "main")
    shell: r"""
        set -euo pipefail
        export LD_LIBRARY_PATH="$CONDA_PREFIX/lib${{LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}}"
        mkdir -p "{params.outdir}"
        
        python python/run_xclone.py \
            --rdr_dir "{params.rdr_dir}" \
            --baf_dir "{params.baf_dir}" \
            --keep_barcodes "{input.keep}" \
            --ref_barcodes "{input.ref}" \
            --outdir "{params.outdir}" \
            --dataset_name "{params.dataset}" \
            --genome_mode "{params.genome_mode}"
            
        # Verify success
        if [ -f "{params.outdir}/_DONE.txt" ]; then
            cp "{params.outdir}/_DONE.txt" "{output.done}"
        else
            echo "XClone Python script finished but _DONE.txt is missing"
            exit 1
        fi
    """

# ===================== histo_pure_benign（两阶段） =====================
def hpb_root(sample):               return combo_root(sample, "histo_pure_benign")
def stage1_dir(sample):             return f"{hpb_root(sample)}/stage1_benign_noref"
def stage2_dir(sample):             return f"{hpb_root(sample)}/stage2_epi_withref"
def tool_stage1_dir(sample, tool):  return f"{stage1_dir(sample)}/{tool}"
def tool_stage2_dir(sample, tool):  return f"{stage2_dir(sample)}/{tool}"
def tool_ref_file(sample, tool):    return f"{hpb_root(sample)}/ref/{tool}_ref.txt"
def tool_label_csv(sample, tool):   return f"{tool_stage1_dir(sample, tool)}/{tool}_label.csv"
def benign_keep_file(sample):       return f"{stage1_dir(sample)}/keep_benign.txt"
def epi_keep_file(sample):          return f"{stage2_dir(sample)}/keep_epi.txt"

TOOLS_HPB   = config.get("histo_pure_benign", {}).get("tools", ["copykat", "SCEVAN","infercnv"])
HPB_POSITIVE= config.get("histo_pure_benign", {}).get("positive_labels", "diploid,normal")

rule select_histo_benign___hpb:
    input:  HISTCSV
    output: benign_keep=benign_keep_file(SAMPLE)
    conda:  "envs/r-shared.yml"
    params:
        labels=",".join(config.get("histology", {}).get("benign_labels", ["Benign"]))
    shell: r"""
        Rscript R/select_histology_labels.R \
          --histology_csv "{input}" \
          --labels "{params.labels}" \
          --out_keep "{output.benign_keep}"
    """

rule select_histo_epi___hpb:
    input:  HISTCSV
    output: epi_keep=epi_keep_file(SAMPLE)
    conda:  "envs/r-shared.yml"
    params:
        labels=",".join(config.get("histology", {}).get("epi_labels", []))
    shell: r"""
        Rscript R/select_histology_labels.R \
          --histology_csv "{input}" \
          --labels "{params.labels}" \
          --out_keep "{output.epi_keep}"
    """

