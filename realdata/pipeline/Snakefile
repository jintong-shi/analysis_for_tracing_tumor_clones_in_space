rule conicsmat:
    input:
        setup = ".snakemake/flags/r_shared_ready",
        keep  = lambda wc: keep_path(wc.combo)
    output:
        done = f"{OUTROOT}/{SAMPLE}/{{combo}}/CONICSmat/_DONE.txt"
    params:
        outdir   = f"{OUTROOT}/{SAMPLE}/{{combo}}/CONICSmat",
        arms     = CONICSMAT_ARMS,
        ref_file = lambda wc: ref_path(wc.combo),
        gene_pos = CONICSMAT_GENE_POS,
        cm_win   = GLOBAL_WINDOW_SIZE,
        cm_exp   = config.get("conicsmat", {}).get("exp_thresh", 0.1),
        cm_thr   = config.get("conicsmat", {}).get("clip_thresh", 4.0)
    conda: "envs/r-shared.yml"
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "conicsmat", "main")
    shell: r"""
        if [ -z "{params.arms}" ]; then
          echo "[CONICSmat] chrom_arm_file not configured"; exit 1
        fi

        set -euo pipefail
        mkdir -p "{params.outdir}"

        set +e
        Rscript --vanilla R/run_conicsmat.R \
          --visium_folder "{VISIUM}" \
          --output_dir     "{params.outdir}" \
          --keep_barcodes_file "{input.keep}" \
          --ref_barcodes_file "{params.ref_file}" \
          --chrom_arm_file "{params.arms}" \
          --gene_pos_file "{params.gene_pos}" \
          --exp_thresh "{params.cm_exp}" \
          --windowsize "{params.cm_win}" \
          --threshold "{params.cm_thr}" \
          --threads {threads}
        rc=$?; set -e

        if [ -f "{params.outdir}/CONICSmat.OK" ]; then
          touch {output.done}
        else
          exit $rc
        fi
    """
# ---- STARCH：只在 no-ref 组合由 final_targets 触发；规则本身通配
rule starch:
    input:
        keep = lambda wc: keep_path(wc.combo)
    output:
        done = f"{OUTROOT}/{SAMPLE}/{{combo}}/STARCH/_DONE.txt"
    log:
        f"{OUTROOT}/{SAMPLE}/{{combo}}/STARCH/starch.log"
    params:
        outdir     = f"{OUTROOT}/{SAMPLE}/{{combo}}/STARCH",
        n_clusters = config.get("starch", {}).get("n_clusters", 3),
        output_nm  = config.get("starch", {}).get("output_name", "STARCH"),
        repo_dir   = config.get("starch", {}).get("repo_dir", ""),
        repo_url   = config.get("starch", {}).get("repo_url", "https://github.com/raphael-group/STARCH.git"),
        visium     = VISIUM
    conda: "envs/starch.yml"
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "starch", "main")
    shell: r"""
        mkdir -p "{params.outdir}"
        set -euo pipefail
        python python/run_starch.py \
          --visium_folder      "{params.visium}" \
          --output_dir         "{params.outdir}" \
          --keep_barcodes_file "{input.keep}" \
          --n_clusters         {params.n_clusters} \
          --output_name        "{params.output_nm}" \
          --starch_repo_dir    "{params.repo_dir}" \
          --starch_repo_url    "{params.repo_url}" > "{log}" 2>&1
        rc=$?
        if [ $rc -ne 0 ]; then
            echo "[STARCH] failed; see log: {log}" >&2
            exit $rc
        fi
        test -f "{params.outdir}/STARCH.OK"
        touch {output.done}
    """
# ---------- infercnvpy ----------
rule infercnvpy_prepare:
    input:
        keep = lambda wc: keep_path(wc.combo),
    output:
        h5ad = f"{OUTROOT}/{SAMPLE}/{{combo}}/infercnvpy/infercnvpy_input.h5ad"
    params:
        visium = VISIUM,
        ref_file = lambda wc: ref_path(wc.combo)
    conda: "envs/infercnvpy.yml"
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "infercnvpy", "prepare")
    shell: r"""
        set -euo pipefail
        python - <<'PY'
import os, sys
import numpy as np
import pandas as pd
import scanpy as sc

visium = "{params.visium}"
mtx_dir = os.path.join(visium, "filtered_feature_bc_matrix")
h5_file = os.path.join(visium, "filtered_feature_bc_matrix.h5")

# 读 10x（用 gene_symbols 作为基因名，便于和 gene_order 对齐）
if os.path.isdir(mtx_dir):
    adata = sc.read_10x_mtx(mtx_dir, var_names="gene_symbols", make_unique=True)
elif os.path.isfile(h5_file):
    adata = sc.read_10x_h5(h5_file)  # scanpy 默认 gene_symbols
    adata.var_names_make_unique()    # read_10x_h5 不自动去重，需手动
else:
    raise SystemExit(f"No 10x matrix under {{visium}}")
    
# 读 keep/ref，并做并集
def read_lines(p):
    if p and os.path.exists(p):
        with open(p) as f:
            return [ln.strip() for ln in f if ln.strip()]
    return []

keep = read_lines("{input.keep}")
ref  = read_lines("{params.ref_file}")
sel  = list(dict.fromkeys(keep + ref))  # 去重且保序

if len(sel) == 0:
    raise SystemExit("No cells after union(keep, ref).")

# 子集（按 sel 顺序）
obs_names = set(adata.obs_names)
sel2 = [c for c in sel if c in obs_names]
if len(sel2) == 0:
    raise SystemExit("None of keep/ref found in 10x barcodes.")
adata = adata[sel2, :].copy()

# 保存
os.makedirs(os.path.dirname("{output.h5ad}"), exist_ok=True)
adata.write_h5ad("{output.h5ad}")
print("[infercnvpy_prepare] wrote:", "{output.h5ad}", "cells:", adata.n_obs, "genes:", adata.n_vars)
PY
    """

rule infercnvpy:
    input:
        h5ad = f"{OUTROOT}/{SAMPLE}/{{combo}}/infercnvpy/infercnvpy_input.h5ad",
        keep = lambda wc: keep_path(wc.combo) 
    output:
        done = f"{OUTROOT}/{SAMPLE}/{{combo}}/infercnvpy/_DONE.txt"
    params:
        outdir   = f"{OUTROOT}/{SAMPLE}/{{combo}}/infercnvpy",
        gene_pos = INFERCNV_GENE_POS,
        ref_file = lambda wc: ref_path(wc.combo),
        win      = GLOBAL_WINDOW_SIZE,
    conda: "envs/infercnvpy.yml"
    threads: GLOBAL_THREADS
    benchmark: bench_path("{combo}", "infercnvpy", "main")
    shell: r"""
        set -euo pipefail
        mkdir -p "{params.outdir}"

        # 允许 ref 文件不存在/为空（脚本内会按 no-ref 处理）
        REF_OPT=""
        if [ -f "{params.ref_file}" ]; then REF_OPT="--ref_spots_file {params.ref_file}"; fi

        python python/run_infercnvpy.py \
          --input_h5ad "{input.h5ad}" \
          --gene_order_file "{params.gene_pos}" \
          --out_dir "{params.outdir}" \
          --window_size {params.win} \
          --n_jobs {threads} \
          $REF_OPT

        test -s "{params.outdir}/infercnvpy.h5ad"
        touch {output.done}
    """

