# ------------ cell2location ------------
def run_c2l(wildcards):
    return config.get("cell2location", {}).get("run", False)
C2L_PROPORTION_FILE = f"{OUTROOT}/{SAMPLE}/cell2location/Decon_proportion.csv"
C2L_PYBIN_DEFAULT = "<CONDA_ROOT>/envs/cell2loc_env/bin/python"
def get_decon_input(wildcards):
    """
    Determines the source of the deconvolution CSV.
    - Mode 2: If C2L is enabled, return the C2L output path (triggers C2L rule).
    - Mode 1: If C2L is disabled, return the static file path from config.
    """
    if config.get("cell2location", {}).get("run", False):
        return C2L_PROPORTION_FILE
    else:
        # Fallback to manual CSV
        csv_path = config.get("decon_csv", "")
        if not csv_path:
            # Safety check to prevent confusing errors later
            raise ValueError("Config Error: 'cell2location.run' is False, but 'decon_csv' is empty.")
        return csv_path
rule run_cell2location:
    input:
        visium_dir = VISIUM, # This variable resolves to /path/to/spaceranger/outs
    output:
        # The script now produces Decon.csv inside the outdir
        decon = f"{OUTROOT}/{SAMPLE}/cell2location/Decon.csv",
        sp_obj = f"{OUTROOT}/{SAMPLE}/cell2location/sp.h5ad"
    params:
        outdir  = f"{OUTROOT}/{SAMPLE}/cell2location",
        ref_dir = config.get("cell2location", {}).get("sc_ref_folder", ""),
        ct_col  = config.get("cell2location", {}).get("cell_type_col", "celltype_major_v2"),
        batch   = config.get("cell2location", {}).get("batch_key", "sample"),
        sample_id = SAMPLE,
        pybin = config.get("cell2location", {}).get("python_bin", C2L_PYBIN_DEFAULT),
        # Default Params from your script
        n_cells = config.get("cell2location", {}).get("N_cells_per_location", 10),
        alpha   = config.get("cell2location", {}).get("detection_alpha", 20),
        # Training Params
        ep_ref  = 250,
        ep_sp   = 30000, # Per your script
        gpu     = "--use_gpu" if config.get("cell2location", {}).get("gpu", False) else ""
    threads: 4
    resources:
        gpu = 1 if config.get("cell2location", {}).get("gpu", False) else 0
    shell:
        """
        if [ ! -x "{params.pybin}" ]; then
          echo "[cell2location] python_bin not found or not executable: {params.pybin}" >&2
          exit 1
        fi
        "{params.pybin}" python/run_cell2location.py \
          --ref_folder "{params.ref_dir}" \
          --visium_path "{input.visium_dir}" \
          --sample_id "{params.sample_id}" \
          --outdir "{params.outdir}" \
          --cell_type_key "{params.ct_col}" \
          --batch_key "{params.batch}" \
          --epochs_ref {params.ep_ref} \
          --epochs_spatial {params.ep_sp} \
          --N_cells {params.n_cells} \
          --alpha {params.alpha} \
          {params.gpu}
        """

