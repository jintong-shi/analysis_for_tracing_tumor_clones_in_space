        done = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/_DONE.txt"
    params:
        outdir      = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/out",
        rdr_dir     = f"{OUTROOT}/{SAMPLE}/{{combo}}/XCLONE/RDR",
