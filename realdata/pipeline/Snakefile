# Helper to dynamically find the CalicoST output subdirectory
def get_calicost_internal_dir(wildcards):
    # Read params from the global config dict
    n_clones = int(CALICOST.get("n_clones", 3))
    method   = CALICOST.get("initialization_method", "rectangle")
    start    = int(CALICOST.get("num_hmrf_initialization_start", 0))
    weight   = float(CALICOST.get("spatial_weight", 1.0))
    
    # Construct the folder name: e.g., "clone3_rectangle0_w1.0"
    subdir = f"clone{n_clones}_{method}{start}_w{weight}"
    
    # Return the full path
    # Note: calicost_cna_dir is defined in your existing script
    return f"{calicost_cna_dir(SAMPLE, wildcards.combo)}/{subdir}"

# ---- setting -----
def benign_shared_file(sample=SAMPLE):
    # 供“常规组合”共用的良性条形码列表（由 histology 选择器生成一次）
    return f"{OUTROOT}/{sample}/_shared/benign_barcodes.txt"

def disp(combo: str) -> str:
    return DISP.get(combo, DEFAULT_DISP.get(combo, combo))

def combo_root(sample, combo): return f"{OUTROOT}/{sample}/{disp(combo)}"
def keep_path(combo):          return f"{combo_root(SAMPLE, combo)}/keep_barcodes.txt"
def ref_path(combo):           return f"{combo_root(SAMPLE, combo)}/ref_barcodes.txt"
def copyvae_work_dir(combo):   return f"{combo_root(SAMPLE, combo)}/copyVAE"
def cost_dir(combo):           return f"{combo_root(SAMPLE, combo)}/compute_cost"
def bench_path(combo, tool, step="main"):
    return f"{cost_dir(combo)}/bench_{tool}__{step}.tsv"
def cost_long_path(combo):     return f"{cost_dir(combo)}/cost_long.csv"
def cost_summary_path(combo):  return f"{cost_dir(combo)}/tool_cost_summary.csv"

def is_no_ref(name: str) -> bool:
    n = name.lower()
    return ("no_ref" in n) or ("no-ref" in n) or ("noref" in n)

def shared_inputs(combo):
    d = {"setup": ".snakemake/flags/r_shared_ready", "keep": keep_path(combo)}
    if combo_needs_ref(combo):
        d["ref"] = ref_path(combo)
    return d

# —— 哪些 combo 需要 ref（这里集中声明，后续只改这里即可）——
COMBOS_WITH_REF = {"decon_stromaimm_ref","decon_auto_ref","histo_tumor_benign_ref"}  # 如需新增，往集合里加
def combo_needs_ref(combo: str) -> bool:
    return canon_combo(combo) in COMBOS_WITH_REF

def _get_ref_param(wildcards, input, **_):
    # input 里有 ref 就返回，否则给空串，shell 里再判断是否加参数
    return input.get("ref", "")

# 统一构建 ref 参数片段（兼容字符串或单元素列表），并对路径加引号
def build_ref_opt(wildcards, input, **_):
    ref = input.get("ref", "")
    if isinstance(ref, (list, tuple)):
        ref = ref[0] if ref else ""
    return f"--ref_barcodes_file \"{ref}\"" if ref else ""

# ==== AutoRef 配置 ====
AUTOREF_CFG = config.get("autoref", {})
# 参与投票的工具（名字小写）；仅会实际触发 ∩ SELECTED_TOOLS
DAR_STAGE1_TOOLS = [t.strip().lower() for t in AUTOREF_CFG.get(
    "stage1_tools", ["copykat","scevan","copyvae","tuscan"]
)]

def autoref_stage1_effective_tools():
    return [t for t in DAR_STAGE1_TOOLS if t in SELECTED_TOOLS]

def _dar_s1_done_list(sample):
    outs = []
    for t in autoref_stage1_effective_tools():
        d = tool_dir(t)  # 你已有：COPYKAT / SCEVAN / copyVAE / TUSCAN
        outs.append(f"{combo_root(sample,'decon_no_ref')}/{d}/_DONE.txt")
    return outs

