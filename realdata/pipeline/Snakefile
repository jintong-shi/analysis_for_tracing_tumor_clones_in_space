rule decon_auto_build_keep_and_ref_from_decon:
    input:
        decon_epi_keep = keep_path('decon_no_ref'),
        s1_done        = _dar_s1_done_list(SAMPLE)
    output:
        keep  = autoref_keep_path(SAMPLE),   # decon_auto_ref/keep_barcodes.txt  ← aneuploid
        ref   = autoref_ref_path(SAMPLE),    # decon_auto_ref/ref/ref_barcodes.txt ← diploid
        audit = autoref_audit_path(SAMPLE)
    params:
        root_decon = combo_root(SAMPLE,'decon_no_ref'),
        min_vote   = AUTOREF_CFG.get("min_vote", None),              # 默认 ceil(n_tools/2)
        tie_policy = AUTOREF_CFG.get("tie_policy","aneuploid").strip().lower()  # 冲突偏向
    conda: "envs/infercnvpy.yml"   # 需要 python + pandas
    threads: 1
    benchmark: bench_path("decon_auto_ref", "autoref", "build")
    shell: r"""
        set -euo pipefail
        python - << 'PY'
import os, math, pandas as pd

root_decon   = r"{params.root_decon}"
epi_keep_set = set([ln.strip() for ln in open(r"{input.decon_epi_keep}") if ln.strip()])

# 期待的 label.csv 路径（存在才读取）
candidates = [
    ("copykat", os.path.join(root_decon, "COPYKAT", "copykat_label.csv")),
    ("scevan",  os.path.join(root_decon, "SCEVAN",  "SCEVAN_label.csv")),
    ("tuscan",  os.path.join(root_decon, "TUSCAN",  "TUSCAN_label.csv")),
    ("copyvae", os.path.join(root_decon, "copyVAE", "copyVAE_label.csv")),
]

frames = []
for name, path in candidates:
    if not os.path.isfile(path) or os.path.getsize(path) == 0:
        # copyVAE 兜底：pred_label.txt + barcodes_order.txt
        if name == "copyvae":
            pred = os.path.join(root_decon, "copyVAE", "pred_label.txt")
            ords = os.path.join(root_decon, "copyVAE", "barcodes_order.txt")
            if os.path.isfile(pred) and os.path.isfile(ords):
                lab = [ln.strip().lower() for ln in open(pred) if ln.strip()]
                bar = [ln.strip() for ln in open(ords) if ln.strip()]
                if len(lab)==len(bar) and len(bar)>0:
                    df = pd.DataFrame({"barcode":bar, "label_copyvae":lab})
                    frames.append(df[df["barcode"].isin(epi_keep_set)])
        continue

    try:
        df = pd.read_csv(path)
    except Exception:
        continue
    if not {"barcode","label"} <= set(df.columns):
        continue
    df = df[["barcode","label"]].copy()
    df["barcode"] = df["barcode"].astype(str)
    df["label"]   = df["label"].astype(str).str.strip().str.lower()
    # 仅在 decon-epi keep 里投票
    df = df[df["barcode"].isin(epi_keep_set)]
    # 只接受精确 "diploid"/"aneuploid"
    df = df[df["label"].isin(["diploid","aneuploid"])]
    if len(df)==0:
        continue
    df.rename(columns={"label": f"label_{name}"}, inplace=True)
    frames.append(df)

if not frames:
    raise SystemExit("No usable xxx_label.csv under decon_no_ref (need barcode,label with diploid/aneuploid).")

# 合并
vote = None
for df in frames:
    vote = df if vote is None else vote.merge(df, how="outer", on="barcode")

tool_cols = [c for c in vote.columns if c.startswith("label_")]
def cnt(row, val): return sum((row[c]==val) for c in tool_cols)
vote["votes_diploid"]   = vote.apply(lambda r: cnt(r,"diploid"),   axis=1)
vote["votes_aneuploid"] = vote.apply(lambda r: cnt(r,"aneuploid"), axis=1)

n_tools = len(tool_cols)
min_vote_cfg = "{params.min_vote}"
if min_vote_cfg in ("None","","none"):
    min_vote = math.ceil(n_tools/2.0)
else:
    try: min_vote = int(min_vote_cfg)
    except: min_vote = math.ceil(n_tools/2.0)

tie_policy = "{params.tie_policy}"  # "aneuploid" or "diploid"

def decide(row):
    vd, va = row["votes_diploid"], row["votes_aneuploid"]
    pass_d = vd >= min_vote
    pass_a = va >= min_vote
    if pass_d and not pass_a: return "diploid"
    if pass_a and not pass_d: return "aneuploid"
    if pass_d and pass_a:
        if vd>va: return "diploid"
        if va>vd: return "aneuploid"
        return tie_policy
    return "none"

vote["final_label"] = vote.apply(decide, axis=1)

ref_bc  = vote.loc[vote["final_label"]=="diploid",   "barcode"].tolist()
keep_bc = vote.loc[vote["final_label"]=="aneuploid", "barcode"].tolist()

os.makedirs(os.path.dirname(r"{output.ref}"), exist_ok=True)
with open(r"{output.ref}", "w") as f:
    for b in ref_bc: f.write(b+"\n")
os.makedirs(os.path.dirname(r"{output.keep}"), exist_ok=True)
with open(r"{output.keep}", "w") as f:
    for b in keep_bc: f.write(b+"\n")

vote.to_csv(r"{output.audit}", index=False)
print(f"[autoref] tools={n_tools} min_vote={min_vote} -> ref(diploid)={len(ref_bc)} keep(aneuploid)={len(keep_bc)}")
PY
    """
