REV_DISP = {v: k for k, v in {**DEFAULT_DISP, **DISP}.items()}

def canon_combo(c: str) -> str:
    """把显示名转换回内部key（如果本来就是内部key则原样返回）"""
    return REV_DISP.get(c, c)

def labels_to_csv(v, default):
    """Normalize labels from config into a comma-separated string."""
    if isinstance(v, str):
        vals = [x.strip() for x in v.split(",") if x.strip()]
    elif isinstance(v, (list, tuple, set)):
        vals = [str(x).strip() for x in v if str(x).strip()]
    elif v is None:
        vals = []
    else:
        vals = [str(v).strip()]
    if not vals:
        vals = [str(x).strip() for x in default if str(x).strip()]
    return ",".join(vals)

HISTO_CFG = config.get("histology", {})
